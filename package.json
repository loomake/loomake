{
  "name": "loomake-monorepo",
  "private": true,
  "type": "module",
  "description": "Loomake のモノレポ（@loomake/core・@loomake/kit・@loomake/trace・@loomake/runner・loomake）",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm -r --silent build && node packages/cli/dist/cli.js verify"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.15.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
