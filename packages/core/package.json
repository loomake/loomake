{
  "name": "@loomake/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Loomake の内部用パッケージ。trace.md・spec.md・tasks.md・テストレポートの読み取りと、verify の結果の JSON スキーマ",
  "keywords": ["openspec", "ai-agent", "requirements-traceability", "spec-driven-development", "claude-code"],
  "homepage": "https://github.com/loomake/loomake#readme",
  "bugs": {
    "url": "https://github.com/loomake/loomake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomake/loomake.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "@loomake/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/verify-result.schema.json": "./schema/verify-result.schema.json"
  },
  "files": ["dist", "schema"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
