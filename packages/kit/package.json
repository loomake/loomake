{
  "name": "@loomake/kit",
  "version": "0.0.0",
  "type": "module",
  "description": "Loomake の内部用パッケージ。verify・init・doctor の本体と、init が配るテンプレート",
  "keywords": ["openspec", "ai-agent", "requirements-traceability", "spec-driven-development", "claude-code"],
  "homepage": "https://github.com/loomake/loomake#readme",
  "bugs": {
    "url": "https://github.com/loomake/loomake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomake/loomake.git",
    "directory": "packages/kit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "@loomake/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "templates"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@loomake/core": "workspace:*"
  }
}
