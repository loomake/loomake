{
  "name": "@loomake/trace",
  "version": "0.0.0",
  "type": "module",
  "description": "Loomake の内部用パッケージ。証拠の記録（trace record）と検収レポート（trace report）",
  "keywords": ["openspec", "ai-agent", "requirements-traceability", "spec-driven-development", "claude-code"],
  "homepage": "https://github.com/loomake/loomake#readme",
  "bugs": {
    "url": "https://github.com/loomake/loomake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomake/loomake.git",
    "directory": "packages/trace"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "@loomake/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@loomake/core": "workspace:*",
    "@loomake/kit": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomake/loomake.git",
    "directory": "packages/trace"
  }
}
